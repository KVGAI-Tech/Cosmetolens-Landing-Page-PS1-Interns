# Cosmetolens frontend — environment variables
# Copy to `.env.local` for local dev. All client-exposed vars MUST be prefixed VITE_.
#
# Reserved for the future backend integration (none required for the UI-only build).
# Base URL of the Cosmetolens API once it exists, e.g. https://api.cosmetolens.com
VITE_API_BASE_URL=
